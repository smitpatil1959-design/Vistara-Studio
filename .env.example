# ============================================================
# Vistara Studio — Environment Configuration
# ============================================================

# --- Supabase Configuration (Frontend Client) ---
# Use the same Supabase project URL and public anon/publishable key for local and deployed auth.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon/publishable key; safe to expose in the browser. Never use a service-role key here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Configuration (Backend / Serverless Functions) ---
# Keep the service-role key server-side only. Never prefix it with VITE_ or NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Optional Compatibility Aliases (only needed by alternate deployment tooling) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth is configured in Supabase Dashboard > Authentication > Providers > Google.
# Do not put Google's client secret in this file. See ENV_SETUP.md for callback setup.

# --- OpenAI (SERVER-SIDE ONLY — never expose to browser) ---
# Used for: web_search_preview internet research via Responses API
# Without this key: system runs in crawl-only / limited-research mode (graceful degradation)
# SECURITY: Must NOT use VITE_*, NEXT_PUBLIC_*, or any frontend-visible prefix.
# Required for: full multi-source internet research (8-15 slides with verified claims)
# Optional: without it, presentations are built from crawl-only evidence (4-6 slides)
OPENAI_API_KEY=sk-...

# --- Research budget (optional, defaults shown) ---
MAX_SEARCH_QUERIES=10         # Max internet search queries per study
MAX_RESEARCH_SOURCES=30       # Max sources to collect per study
MIN_SLIDES=6                  # Minimum slides in a generated presentation
MAX_SLIDES_TARGET=15          # Target maximum slides (never creates filler to reach this)
OPENAI_MODEL=gpt-4o           # OpenAI model for research + copy polish

# --- Provider selection (server only) ---
# auto: prefer NVIDIA when configured, then other configured providers.
# none: no paid/model calls; real crawling, evidence and deck generation still work.
# nvidia: use only the NVIDIA key for interpretation and copy writing.
AI_PROVIDER=auto
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA chat completion does not supply OpenAI's built-in web-search tool.
# Official-page crawling and public-source research work with every provider.
